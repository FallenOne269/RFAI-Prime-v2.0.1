root = true

# ── Baseline for everything ──────────────────────────────────────────────────
[*]
charset             = utf-8
end_of_line         = lf
insert_final_newline  = true
trim_trailing_whitespace = true

# ── Python ───────────────────────────────────────────────────────────────────
[*.{py,pyi}]
indent_style = space
indent_size  = 4
max_line_length = 99

# ── Markdown ─────────────────────────────────────────────────────────────────
# Two trailing spaces = intentional line break in some renderers;
# set trim_trailing_whitespace = false to preserve them if you use that style.
[*.md]
indent_style = space
indent_size  = 2
trim_trailing_whitespace = false

# ── TOML / YAML / JSON ───────────────────────────────────────────────────────
[*.{toml,yaml,yml,json}]
indent_style = space
indent_size  = 2

# ── Shell ─────────────────────────────────────────────────────────────────────
[*.sh]
indent_style = space
indent_size  = 2
